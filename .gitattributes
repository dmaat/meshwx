# Normalize line endings of all text files in the repository (LF); the rules below pin LF on checkout too.
* text=auto
# Shell scripts, systemd units and udev rules must keep LF endings even on a
# Windows checkout, or bash/systemd/udev reject them on the Pi.
*.sh      text eol=lf
*.service text eol=lf
*.rules   text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.pb      binary
*.zip     binary
